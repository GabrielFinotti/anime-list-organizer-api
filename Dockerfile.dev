# Use an official Node runtime as a parent image
FROM node:latest

# Create app directory
WORKDIR /app

# Set environment
ENV NODE_ENV=development

# Install build tools for native modules (bcrypt, etc.)
RUN apt-get update && apt-get install -y python3 build-essential --no-install-recommends && rm -rf /var/lib/apt/lists/*

# Copy package files and install deps (including dev dependencies for hot reload)
COPY package.json package-lock.json ./

RUN npm ci

# Copy app source
COPY . .

# Expose app port
EXPOSE 3000

# Default command for dev: runs the hot-reload script
CMD ["npm", "run", "dev"]
