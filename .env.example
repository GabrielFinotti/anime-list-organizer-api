# =================================
# ANIME LIST ORGANIZER API - PRODUCTION
# =================================

# ---------------------------------
# SERVER CONFIGURATION
# ---------------------------------
PORT=3333
VERSION=v3

# ---------------------------------
# DATABASE CONFIGURATION
# ---------------------------------
MONGODB_URI=mongodb://mongo:27017/anime-list-organizer

# ---------------------------------
# OPENAI CONFIGURATION
# ---------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# ---------------------------------
# AUTHENTICATION
# ---------------------------------
BASIC_USERNAME=admin
BASIC_PASSWORD=your-secure-password-here

# ---------------------------------
# DOCKER CONFIGURATION
# ---------------------------------
# Porta do MongoDB (padrão: 27017)
MONGO_PORT=27017

# Caminho para persistência de dados (padrão: ./data/mongo)
DATA_PATH=./data/mongo

# ---------------------------------
# MEMORY AND TIMEZONE CONFIGURATION
# ---------------------------------
# Limitar memória do Node.js para 1.5GB (1536MB)
NODE_OPTIONS=--max-old-space-size=1536

# Configurar timezone para Recife
TZ=America/Recife
