{
  "name": "anime-list-organizer-api",
  "version": "3.1.1",
  "description": "API Dedicada para o Anime List Organizer",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsup src/server.ts --format cjs",
    "dev": "tsx watch src/server.ts",
    "docker:build": "docker build -t anime-list-api .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:app": "docker-compose logs -f app",
    "docker:logs:mongo": "docker-compose logs -f mongo",
    "docker:restart": "docker-compose restart",
    "docker:clean": "docker system prune -f && docker volume prune -f",
    "docker:setup": "cp .env.example .env && mkdir -p data/mongo && docker-compose up -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielFinotti/anime-list-organizer-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/GabrielFinotti/anime-list-organizer-api/issues"
  },
  "homepage": "https://github.com/GabrielFinotti/anime-list-organizer-api#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.2",
    "openai": "^5.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "tsup": "^8.5.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
