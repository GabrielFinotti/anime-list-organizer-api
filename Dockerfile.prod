# Build stage
FROM node:latest AS builder

WORKDIR /app

# Install build tools for native modules (bcrypt, etc.)
RUN apt-get update && apt-get install -y python3 build-essential --no-install-recommends && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package.json package-lock.json ./

# Install all dependencies (including devDependencies for build)
RUN npm ci

# Copy app source
COPY . .

# Build the application
RUN npm run build

# Production stage
FROM node:latest

WORKDIR /app

# Set environment to production
ENV NODE_ENV=production

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package.json package-lock.json ./

# Install only production dependencies
RUN npm ci --omit=dev

# Copy built application from builder stage
COPY --from=builder /app/dist ./dist

# Create non-root user for security (use UID 1001 to avoid conflicts)
RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

# Expose app port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Production command
CMD ["npm", "start"]
