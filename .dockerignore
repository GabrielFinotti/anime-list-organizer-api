# .dockerignore for anime-list-organizer-api

# Node modules
node_modules
**/node_modules

# Build outputs
dist
build

# Coverage and test artifacts
coverage
.nyc_output

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment files
.env
.env.*.local
.env.local

# Git and editor files
.git
.gitignore
.vscode/
.idea/
.DS_Store

# Docker config files (not needed in build context)
Dockerfile*
docker-compose*.yml
docker-compose*.yaml

# Tests and test config
tests
*.spec.*
*.test.*
jest.config.*
tsconfig.jest.json

# Caches and temp
.cache
.tmp
.temp

# Misc
*.swp

# Optional: lock files if you want smaller context
# package-lock.json
# pnpm-lock.yaml
# yarn.lock
