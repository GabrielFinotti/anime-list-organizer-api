{
  "name": "anime-timeline-api",
  "version": "4.0.0-dev",
  "description": "API Dedicada para o Anime Timeline",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsup",
    "dev": "tsx watch src/server.ts",
    "build:docker": "docker build -f Dockerfile.prod -t anime-timeline-api . --no-cache",
    "dev:docker": "cp .env.development .env && docker compose -f docker-compose.dev.yml down && docker compose -f docker-compose.dev.yml up --build",
    "docker:up": "cp .env.production .env && docker compose -f docker-compose.prod.yml up --build -d",
    "docker:down": "docker compose -f docker-compose.prod.yml down",
    "docker:rebuild": "docker compose -f docker-compose.prod.yml down && docker build -f Dockerfile.prod -t anime-timeline-api . --no-cache && docker compose -f docker-compose.prod.yml up -d",
    "docker:logs": "docker logs -f api-prod",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit:coverage": "jest --selectProjects unit --coverage",
    "test:integration:coverage": "jest --selectProjects integration --coverage",
    "lint:format": "prettier --write .",
    "lint:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielFinotti/anime-timeline-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/GabrielFinotti/anime-timeline-api/issues"
  },
  "homepage": "https://github.com/GabrielFinotti/anime-timeline-api#readme",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.3.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "openai": "^6.9.1",
    "sharp": "^0.34.5",
    "ulid": "^3.0.1"
  }
}
